{
  "name": "attendance-ci-cd-sample",
  "version": "1.0.0",
  "description": "Sample Express application for DevOps Assignment 4 Task 2",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build": "node -c src/app.js && node -c src/server.js && node -c src/attendanceService.js",
    "test:unit": "cross-env JEST_JUNIT_OUTPUT_DIR=reports/unit JEST_JUNIT_OUTPUT_NAME=junit.xml jest tests/unit --runInBand --reporters=default --reporters=jest-junit",
    "test:integration": "cross-env JEST_JUNIT_OUTPUT_DIR=reports/integration JEST_JUNIT_OUTPUT_NAME=junit.xml jest tests/integration --runInBand --reporters=default --reporters=jest-junit",
    "test": "npm run test:unit && npm run test:integration",
    "package": "mkdir -p dist && npm pack --pack-destination dist"
  },
  "keywords": [
    "jenkins",
    "devops",
    "express",
    "attendance"
  ],
  "author": "Kashish",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "supertest": "^6.3.4"
  }
}